PORT=3001
GOOGLE_APPLICATION_CREDENTIALS=./credentials/dialogflow-service-account.json
DIALOGFLOW_PROJECT_ID=your_dialogflow_project_id

# Supabase Client (Frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Set to true to serve the public News page through the Flask backend (backend/, port 5000).
# Leave false unless Flask is running — `npm run dev:all` does not start it.
VITE_USE_FLASK_NEWS=false

# Supabase (Node chat server — server-side only, used to load admin-edited chatbot
# responses from the intent_responses table)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key
