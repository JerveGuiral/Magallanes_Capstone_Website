PORT=3001
GOOGLE_APPLICATION_CREDENTIALS=./credentials/dialogflow-service-account.json
DIALOGFLOW_PROJECT_ID=your_dialogflow_project_id

# Supabase Client (Frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Set to true to serve the public News page through the Flask backend (backend/, port 5000).
# Leave false unless Flask is running — `npm run dev:all` does not start it.
VITE_USE_FLASK_NEWS=false

# Supabase (Node chat server — server-side only, used to load admin-edited chatbot
# responses from the intent_responses table)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key

# --- Deployment (docs/DEPLOYMENT.md) ---

# Website (Vercel). Leave VITE_API_URL empty locally: Vite proxies /api to the chat server.
# Once deployed, set it to the chat server's address, e.g. https://magallanes-chat.onrender.com
VITE_API_URL=
# Keep false until the LGU formally adopts the site: the pages then say "capstone project" and
# ask search engines not to index them. true switches to the official wording.
VITE_OFFICIAL_SITE=false

# Chat server (Render). On a host there is no credentials file: paste the Dialogflow
# service-account JSON as one line instead of GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_CREDENTIALS_JSON=
# The website's address(es), comma-separated. Only these origins may call the chat API, and the
# per-visitor rate limit (20 messages a minute) turns on.
ALLOWED_ORIGINS=
# Override the rate limit (messages per minute per visitor; 0 = off).
CHAT_RATE_LIMIT=
