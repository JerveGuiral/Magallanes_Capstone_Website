PORT=3001
GOOGLE_APPLICATION_CREDENTIALS=./credentials/dialogflow-service-account.json
DIALOGFLOW_PROJECT_ID=your_dialogflow_project_id

# Supabase Client Configuration
# Replace these with your actual Supabase Project URL and Anon/Publishable API Key from your Supabase Project Settings -> API:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Backend Python / Service Role configuration (if using backend/):
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key
